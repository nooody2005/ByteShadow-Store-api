el[\\\\/]/.test(shortStackTrace[1].getFileName()),\n    trace: shortStackTrace.map(frame => `    at ${frame}`).join(\"\\n\"),\n  };\n}\n"},"lineCount":null}},"error":null,"hash":"b0f36d7b2ed33b21c9c86e493c33ea4e","cacheData":{"env":{}}}