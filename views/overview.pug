    //- Start Video
    .video
        video(autoplay, muted)
            source(src="/images/awesome-video.mp4", type="video/mp4")

        .text
            h2 Behind Every Painting
            p Every brushstroke tells a story.
            button Explore Gallery
    //- End Video


    //- Start Contact Us
    .contact#contact
        .container

            .main-heading
                .container
                    .text
                        h2 Contact Us

            .content

                form(action="")
                    input.main-input(
                        type="text"
                        name="name"
                        placeholder="Your Name"
                    )

                    input.main-input(
                        type="email"
                        name="email"
                        placeholder="Your Email"
                    )

                    textarea.main-input(
                        name="message"
                        placeholder="Your Message"
                    )

                    input(
                        type="submit"
                        value="send message"
                    )

                .info
                    h4 Get In Touch
                    span.phone +001551037389
                    span.phone +001551037389

                    h4 Where We Are

                    address
                        | Awesome Address 17
                        br
                        | New York, NYC
                        br
                        | 01551037389
                        br
                        | USA
    //- End Contact Us

