extends base

block content


    //- Start Landing
    .landing#home
        .overlay
            .text
                .content
                    h2
                        | Hello World!
                        br
                        | I'm Nada I make art.

                    p
                        | Welcome to Colorful Creations Store! We offer a vibrant collection of paintings that add color and life to any space. Each piece is crafted with passion and creativity, bringing unique art to your place.

        a.go-down(href="#gallery")
            i.fas.fa-angle-double-down.fa-2x
    //- End Landing


    //- Start Gallery
    .gallery#gallery
        .container

            .main-heading
                .container
                    .text
                        h2 Gallery

            //- Shuffle
            ul.shuffle
                li.active All
                li Expressive
                li Romantic
                li Nature

            //- Gallery Content
            .gallery-content

                .box
                    .image
                        img(src="/img/1.jpg", alt="Painting")
                        .text
                            h3.painting-Name Painting Name
                            p.breif-overview a little description for painting..
                            span 40 * 60 cm

                            .price
                                span.current-price
                                    span.number 120
                                    span.currency $

                            .info
                                a(href="#") Details
                                i.fas.fa-long-arrow-alt-right

