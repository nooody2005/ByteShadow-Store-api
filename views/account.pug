extends base

block head
    link(rel="stylesheet", href="/css/account.css")

block content

    //- Start Account Page
    main.account-page
        .container

            .account-view

                //- Start Sidebar
                nav.account-menu

                    ul.side-nav

                        li.side-nav--active
                            a(href="#settings")
                                i.fas.fa-user-cog
                                span Account Settings

                        li
                            a(href="#bids")
                                i.fas.fa-gavel
                                span My Bids

                        li
                            a(href="#favorites")
                                i.fas.fa-heart
                                span Favorites

                        li
                            a(href="#purchases")
                                i.fas.fa-palette
                                span My Purchases

                        li
                            a(href="#password")
                                i.fas.fa-lock
                                span Change Password

                        li
                            a(href="#")
                                i.fas.fa-sign-out-alt
                                span Logout

                //- End Sidebar


                //- Start Account Content
                .account-content

                    //- Account Settings
                    section.account-section#settings

                        h2 Account Settings

                        p.section-description
                            | Manage your personal information and profile.

                        form.account-form

                            .form-group
                                label(for="name") Full Name

                                input#name(
                                    type="text"
                                    value="Nada Hashem"
                                    name="name"
                                    required
                                )

                            .form-group
                                label(for="email") Email Address

                                input#email(
                                    type="email"
                                    value="nada@example.com"
                                    name="email"
                                    required
                                )

                            .form-group
                                label(for="phone") Phone Number

                                input#phone(
                                    type="tel"
                                    placeholder="Enter your phone number"
                                    name="phone"
                                )

                            .profile-photo

                                img(
                                    src="/images/1.jpg"
                                    alt="User Profile"
                                )

                                div
                                    label(for="photo") Profile Photo

                                    input#photo(
                                        type="file"
                                        accept="image/*"
                                        name="photo"
                                    )

                            button.account-btn(type="submit")
                                | Save Changes


                    //- My Bids
                    section.account-section#bids

                        h2 My Bids

                        p.section-description
                            | Track the paintings you are currently bidding on.

                        .account-card

                            img(
                                src="/images/1.jpg"
                                alt="Painting"
                            )

                            .card-info

                                h3 Painting Name

                                p
                                    | Your current bid:
                                    strong $150

                                p
                                    | Current highest bid:
                                    strong $170

                                span.status Auction Active

                            a.card-btn(href="#")
                                | View Painting


                    //- Favorites
                    section.account-section#favorites

                        h2 Favorites

                        p.section-description
                            | Paintings you saved to your favorites.

                        .account-card

                            img(
                                src="/images/1.jpg"
                                alt="Favorite Painting"
                            )

                            .card-info

                                h3 Beautiful Nature

                                p
                                    | A beautiful artwork added to your favorites.

                                strong $120

                            a.card-btn(href="#")
                                | View Painting


                    //- My Purchases
                    section.account-section#purchases

                        h2 My Purchases

                        p.section-description
                            | View the artworks you have purchased.

                        .account-card

                            img(
                                src="/images/1.jpg"
                                alt="Purchased Painting"
                            )

                            .card-info

                                h3 My Painting

                                p
                                    | Purchased on:
                                    strong 15 Jul 2026

                                span.status.purchased Purchased

                            a.card-btn(href="#")
                                | View Details


                    //- Change Password
                    section.account-section#password

                        h2 Change Password

                        p.section-description
                            | Keep your account secure by updating your password.

                        form.account-form

                            .form-group
                                label(for="current-password")
                                    | Current Password

                                input#current-password(
                                    type="password"
                                    placeholder="••••••••"
                                    required
                                )

                            .form-group
                                label(for="new-password")
                                    | New Password

                                input#new-password(
                                    type="password"
                                    placeholder="••••••••"
                                    required
                                )

                            .form-group
                                label(for="confirm-password")
                                    | Confirm New Password

                                input#confirm-password(
                                    type="password"
                                    placeholder="••••••••"
                                    required
                                )

                            button.account-btn(type="submit")
                                | Change Password

                //- End Account Content

    //- End Account Page