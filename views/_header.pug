// Start Header
.header
    .container

        .logo
            img(src="/img/1.jpg", alt="Byte Shadow Logo")
            h3 BYTE SHADOW

        .links
            .auth
                if user
                    a.user-profile(href="/profile")
                        img(
                            src=`/img/users/${user.photo}`
                            alt=user.name
                        )
                        span= user.name

                    a(href="/logout") Logout

                else
                    a(href="/login") Login
                    a(href="/signup") Sign Up
            //- .auth
            //-     a(href="/login") Login
            //-     a(href="/signup") Sign Up

            .menu
                span.icons
                    span
                    span
                    span

                ul
                    li
                        a(href="/") Home
                    li
                        a(href="#gallery") Gallery
                    li
                        a(href="#decoration") Decoration
                    li
                        a(href="#contact") Contact Us


