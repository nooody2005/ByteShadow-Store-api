                span
                h2 Painting Process
                span

            p
                | Follow the journey of this artwork from the first sketch to the final masterpiece.

            .stage-images
                each image in painting.stageImages
                    img( src=`/img/paintings/${painting.name.replace(/\s+/g, '-')}/stage-${image}`, alt="stages")
