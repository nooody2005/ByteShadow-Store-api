extends base

block head
    link(rel="stylesheet", href="/css/details.css")

block content


//- Start Painting
.painting
    .container
        .painting-content

            .image
                img(src="/images/1.jpg", alt="Painting")

            .details
                h1.painting-Name Painting Name

                p.breif-overview
                    | Lorem ipsum dolor sit amet consectetur hbvjnvkva habivihbiayb..

                .sale-section

                    .price
                        h3 Current Highest Bid

                        span.current-price
                            span.number 120
                            span.currency $

                        .bid-box
                            label(for="bid") Your Bid

                            input.bid-input(
                                id="bid"
                                type="number"
                                value="120"
                                min="121"
                                step="1"
                            )

                        button.bid-btn(type="button") Place Bid

                    .info

                        .size
                            span.title
                                i.fas.fa-ruler-combined
                                | Size

                            span.value 20 * 30 cm

                        .date
                            span.title
                                i.far.fa-calendar-alt
                                | Created

                            span.value 15 Jul 2025

                        .auction-info
                            span.title
                                i.fas.fa-gavel
                                | Auction Ends

                            span.value 30 Jul 2026

//- End Painting


