extends ../base

block head
    link(rel="stylesheet", href="/css/account.css")
    link(rel="stylesheet", href="/css/overview.css")
    link(rel="stylesheet", href="/css/details.css")
    link(rel="stylesheet", href="/css/auth.css")

block content
    section.auth-page
        .container
            .auth-box
                h2 Reset Password

                p Enter your new password and confirm it below.

                form.form--reset-password(data-token=token)
                    .input-box
                        i.fas.fa-lock
                        input#password(
                            type="password"
                            placeholder="New Password"
                            required
                            minlength="8"
                        )

                    .input-box
                        i.fas.fa-lock
                        input#passwordConfirm(
                            type="password"
                            placeholder="Confirm New Password"
                            required
                            minlength="8"
                        )

                    button.auth-btn(type="submit") Reset Password

                .auth-switch
                    a(href="/login") Back to Login



block append scripts
    script(src="/js/reset-password-build/resetPassword.js")