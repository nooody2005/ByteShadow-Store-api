
extends ../base

block head
    link(rel="stylesheet", href="/css/account.css")
    link(rel="stylesheet", href="/css/overview.css")
    link(rel="stylesheet", href="/css/details.css")
    link(rel="stylesheet", href="/css/auth.css")

block content
    section.auth-page
        .container
            .auth-box
                h2 Forgot Password?

                p Enter your email address and we'll send you a link to reset your password.

                form.form--forgot-password
                    .input-box
                        i.fas.fa-envelope
                        input#email(
                            type="email"
                            placeholder="Email Address"
                            required
                        )

                    button.auth-btn(type="submit") Send Reset Link

                .auth-switch
                    | Remember your password?
                    a(href="/login") Login

block append scripts
    script(src="/js/forgot-password-build/forgotPassword.js")
    //- script(type="module" src="/js/forgotPassword.js")
